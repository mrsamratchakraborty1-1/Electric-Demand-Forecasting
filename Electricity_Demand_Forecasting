      "metadata": {
        "id": "8fxtuCVlEk0S"
      },
      "source": [
        "5. flag price spikes"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "c4bolUrHEEr-",
        "outputId": "32a61f8d-2dde-4b86-b248-ffa9f3bc99b5"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Price spike threshold (99th pct): 247.039 $/MWh\n",
            "Spike count: 27\n"
          ]
        }
      ],
      "source": [
        "# Flag price spikes (informational — values retained)\n",
        "# Negative and extreme positive prices are legitimate in electricity markets\n",
        "# (renewable over-supply / scarcity events). We flag but do NOT remove them.\n",
        "spike_thr = df[\"RRP\"].quantile(0.99)\n",
        "df[\"price_spike_flag\"] = (df[\"RRP\"] > spike_thr).astype(int)\n",
        "print(f\"Price spike threshold (99th pct): {spike_thr:.3f} $/MWh\")\n",
        "print(f\"Spike count: {df['price_spike_flag'].sum()}\")"
      ]
    },
    {
