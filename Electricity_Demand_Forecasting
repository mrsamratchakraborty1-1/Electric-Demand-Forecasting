      "source": [
        "from statsmodels.tsa.holtwinters import SimpleExpSmoothing\n",
        "\n",
        "# Helper: signed-log inverse transform\n",
        "def inverse_signed_log(y):\n",
        "    \"\"\"Inverse of sign(x)·log(1+|x|) → original $/MWh space.\"\"\"\n",
        "    return np.sign(y) * (np.expm1(np.abs(y)))\n",
        "\n",
        "# Prepare val and test series\n",
        "# Signed-log transform requires no training statistics, safe to apply directly\n",
        "val_rrp_slog  = np.sign(df_val_raw[\"RRP\"].values)  * np.log1p(np.abs(df_val_raw[\"RRP\"].values))\n",
        "test_rrp_slog = np.sign(df_test_raw[\"RRP\"].values) * np.log1p(np.abs(df_test_raw[\"RRP\"].values))\n",
        "\n",
        "val_rrp_raw   = df_val_raw[\"RRP\"].values\n",
        "test_rrp_raw  = df_test_raw[\"RRP\"].values\n",
        "\n",
        "train_rrp_slog = df[\"RRP_signed_log\"].values\n",
        "\n",
        "HORIZON = 4   # 4-step-ahead = 1 hour"
      ]
    },
