      "source": [
        "def walk_forward_predict_lstm(model, scaler_X_col, scaler_y, df_fit, df_eval,\n",
        "                               lookback, step=4):\n",
        "    \"\"\"Walk-forward H-step forecasts on df_eval.\n",
        "\n",
        "    scaler_X_col is fitted ONLY on the demand-lag column (column 0). Calendar features are already\n",
        "    in [-1,1] / {0,1} so they are passed through unchanged.\n",
        "    \"\"\"\n",
        "    full = pd.concat([df_fit, df_eval], ignore_index=True)\n",
        "    nf   = len(df_fit)\n",
        "    y_all = full['TOTALDEMAND'].values.astype(np.float32)\n",
        "    c_all = full[CAL_COLS].values.astype(np.float32)\n",
        "\n",
        "    acts, preds = [], []\n",
        "    model.eval()\n",
        "    for s in range(0, len(df_eval) - H + 1, step):\n",
        "        i = nf + s\n",
        "        if i < lookback:\n",
        "            continue\n",
        "        lag_col   = y_all[i-lookback:i].reshape(-1, 1)\n",
        "        cal_block = c_all[i-lookback:i]\n",
        "        # Scale demand column only\n",
        "        lag_col_s = scaler_X_col.transform(lag_col).astype(np.float32)\n",
        "        x = np.concatenate([lag_col_s, cal_block], axis=1)[None]    # (1, lookback, 1+n_cal)\n",
        "        with torch.no_grad():\n",
        "            yhat_s = model(torch.tensor(x).to(DEVICE)).cpu().numpy()[0]\n",
        "        yhat = scaler_y.inverse_transform(yhat_s.reshape(-1, 1)).flatten()\n",
        "        acts.append(df_eval['TOTALDEMAND'].values[s:s+H])\n",
        "        preds.append(yhat)\n",
        "    return np.concatenate(acts), np.concatenate(preds)"
      ]
