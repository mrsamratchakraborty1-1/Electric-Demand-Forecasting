    {
      "cell_type": "markdown",
      "metadata": {
        "id": "3YZX-f5qT9yJ"
      },
      "source": [
        "1. Sequences for LSTM"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "GuQkFNCST0Ko",
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "outputId": "2353404f-4b98-4fca-ea44-42f28e4ef023"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Lookback p=8 → X shape: (2676, 8, 6)   y shape: (2676, 4)\n",
            "Each window has 8 timesteps × 6 features (1 lag + 5 calendar features)\n"
          ]
        }
      ],
      "source": [
        "def make_sequences_lstm(df_in, lookback):\n",
        "    \"\"\"Build 3-D sliding-window arrays for the LSTM.\n",
        "\n",
        "    X[i] shape: (lookback, 1 + n_cal)\n",
        "        - column 0       : demand lag\n",
        "        - columns 1..n_cal: calendar features at each timestep\n",
        "    y[i] shape: (H,)  — next 4 demand values\n",
        "    \"\"\"\n",
        "    y = df_in['TOTALDEMAND'].values.astype(np.float32)\n",
        "    c = df_in[CAL_COLS].values.astype(np.float32)\n",
        "    Xs, ys = [], []\n",
        "    for i in range(lookback, len(y) - H + 1):\n",
        "        # Stack the demand lag (1 column) with the calendar features (n_cal columns)\n",
        "        lag_col = y[i-lookback:i].reshape(-1, 1)\n",
        "        cal_block = c[i-lookback:i]\n",
        "        Xs.append(np.concatenate([lag_col, cal_block], axis=1))\n",
        "        ys.append(y[i:i+H])\n",
        "    return np.array(Xs, np.float32), np.array(ys, np.float32)\n",
        "\n",
        "# Sanity check\n",
        "X_demo, y_demo = make_sequences_lstm(df_tr, lookback=8)\n",
        "print(f'Lookback p=8 → X shape: {X_demo.shape}   y shape: {y_demo.shape}')\n",
        "print(f'Each window has {X_demo.shape[1]} timesteps × {X_demo.shape[2]} features '\n",
        "      f'(1 lag + {N_CAL} calendar features)')"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "jWouzZaYUFH4"
      },
      "source": [
        "2. LSTM Architecture\n",
        "\n",
        "We use a many to one LSTM. At each timestep, the LSTM computes four gates that\n",
        "regulate the flow of information through the cell state $C_t$:\n",
        "\n",
        "$$g^f_t = \\sigma(U_f x_t + W_f h_{t-1} + b_f) \\qquad \\text{(forget gate)}$$\n",
        "$$g^i_t = \\sigma(U_i x_t + W_i h_{t-1} + b_i) \\qquad \\text{(input gate)}$$\n",
        "$$g^o_t = \\sigma(U_o x_t + W_o h_{t-1} + b_o) \\qquad \\text{(output gate)}$$\n",
        "$$C_t = g^f_t \\odot C_{t-1} + g^i_t \\odot \\tilde C_t, \\qquad h_t = g^o_t \\odot \\tanh(C_t)$$"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "gffJA9UlUBxw",
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "outputId": "9648f7dd-ee37-4b8b-a8c2-ccdbd72d40ef"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "DemandLSTM(\n",
            "  (lstm): LSTM(6, 64, num_layers=2, batch_first=True, dropout=0.1)\n",
            "  (dropout): Dropout(p=0.1, inplace=False)\n",
            "  (fc): Linear(in_features=64, out_features=4, bias=True)\n",
            ")\n",
            "\n",
            "Total parameters: 51,972\n"
          ]
        }
      ],
      "source": [
        "class DemandLSTM(nn.Module):\n",
        "    \"\"\"Many-to-one LSTM for 4-step-ahead demand forecasting.\n",
        "\n",
        "    Input  : [batch, lookback, 1 + n_cal]\n",
        "    LSTM   : 2 stacked layers, hidden_size units, batch_first=True\n",
        "    Dropout: applied on the final hidden output\n",
        "    FC     : Linear(hidden_size → H)\n",
        "    Output : [batch, H]\n",
        "    \"\"\"\n",
        "    def __init__(self, n_features, hidden_size, num_layers, dropout):\n",
        "        super().__init__()\n",
        "        self.lstm = nn.LSTM(\n",
        "            input_size=n_features,\n",
        "            hidden_size=hidden_size,\n",
        "            num_layers=num_layers,\n",
        "            batch_first=True,\n",
        "            dropout=dropout if num_layers > 1 else 0.0,\n",
        "        )\n",
        "        self.dropout = nn.Dropout(dropout)\n",
        "        self.fc      = nn.Linear(hidden_size, H)\n",
        "\n",
        "    def forward(self, x):\n",
        "        out, _ = self.lstm(x)\n",
        "        out    = out[:, -1, :]               # take last timestep's hidden state\n",
        "        return self.fc(self.dropout(out))\n",
        "\n",
        "# Quick architecture check\n",
        "demo_lstm = DemandLSTM(n_features=1 + N_CAL, hidden_size=64, num_layers=2, dropout=0.1)\n",
        "n_params_lstm = sum(p.numel() for p in demo_lstm.parameters())\n",
        "print(demo_lstm)\n",
        "print(f'\\nTotal parameters: {n_params_lstm:,}')"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "KFw9vOkrUOjB"
      },
      "source": [
        "3. Training Routine"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "jcsYC3vZUKj3"
      },
      "outputs": [],
      "source": [
        "def train_lstm(model, X_tr, y_tr, X_va, y_va,\n",
        "               lr=1e-3, epochs=80, batch_size=128, patience=10):\n",
        "    \"\"\"Train an LSTM with gradient clipping + early stopping on validation MSE.\"\"\"\n",
        "    model = model.to(DEVICE)\n",
        "    opt   = torch.optim.Adam(model.parameters(), lr=lr)\n",
        "    sched = torch.optim.lr_scheduler.ReduceLROnPlateau(opt, patience=4, factor=0.5)\n",
        "    loss_fn = nn.MSELoss()\n",
        "\n",
        "    ds_tr  = TensorDataset(torch.tensor(X_tr), torch.tensor(y_tr))\n",
        "    loader = DataLoader(ds_tr, batch_size=batch_size, shuffle=True)\n",
        "    X_va_t = torch.tensor(X_va).to(DEVICE)\n",
        "    y_va_t = torch.tensor(y_va).to(DEVICE)\n",
        "\n",
        "    best_val, best_state, wait = np.inf, None, 0\n",
        "    tr_hist, va_hist = [], []\n",
        "\n",
        "    for epoch in range(epochs):\n",
        "        model.train(); ep_loss = 0.0\n",
        "        for xb, yb in loader:\n",
        "            xb, yb = xb.to(DEVICE), yb.to(DEVICE)\n",
        "            opt.zero_grad()\n",
        "            loss = loss_fn(model(xb), yb)\n",
        "            loss.backward()\n",
        "            nn.utils.clip_grad_norm_(model.parameters(), max_norm=1.0)   # ← RNN-specific\n",
        "            opt.step()\n",
        "            ep_loss += loss.item() * len(xb)\n",
        "        ep_loss /= len(X_tr)\n",
        "\n",
        "        model.eval()\n",
        "        with torch.no_grad():\n",
        "            val_loss = loss_fn(model(X_va_t), y_va_t).item()\n",
        "        sched.step(val_loss)\n",
        "        tr_hist.append(ep_loss); va_hist.append(val_loss)\n",
        "\n",
        "        if val_loss < best_val:\n",
        "            best_val   = val_loss\n",
        "            best_state = copy.deepcopy(model.state_dict())\n",
        "            wait = 0\n",
        "        else:\n",
        "            wait += 1\n",
        "            if wait >= patience:\n",
        "                break\n",
        "\n",
        "    model.load_state_dict(best_state)\n",
        "    return model, tr_hist, va_hist, best_val"
      ]
