      "source": [
        "# TIME-SERIES CV FOR ALPHA SELECTION\n",
        "\n",
        "def ts_cv_alpha(train_df, target_col, lags, horizon, alphas,\n",
        "                n_splits=3, target_transform_cls=None):\n",
        "    n         = len(train_df)\n",
        "    min_warm  = max(lags) + horizon + 10\n",
        "    usable    = n - min_warm\n",
        "    fold_size = usable // (n_splits + 1)\n",
        "\n",
        "    if fold_size < horizon * 4:\n",
        "        raise ValueError(\n",
        "            f\"Training set too small for {n_splits} CV folds with max lag {max(lags)}.\"\n",
        "        )\n",
        "\n",
        "    cv_scores = {a: [] for a in alphas}\n",
        "\n",
        "    for fold in range(1, n_splits + 1):\n",
        "        cv_train_end = min_warm + fold * fold_size\n",
        "        cv_val_end   = cv_train_end + fold_size\n",
        "        if cv_val_end > n:\n",
        "            break\n",
        "\n",
        "        cv_train_df = train_df.iloc[:cv_train_end].copy()\n",
        "        cv_full_df  = train_df.iloc[:cv_val_end].copy().reset_index(drop=True)\n",
        "\n",
        "        for alpha in alphas:\n",
        "            tt = None\n",
        "            if target_transform_cls is not None:\n",
        "                tt = target_transform_cls()\n",
        "                tt.fit(cv_train_df[target_col].values.reshape(-1, 1))\n",
        "\n",
        "            models_cv, scaler_cv, _ = train_direct_regression(\n",
        "                cv_train_df, target_col, lags, horizon, alpha, tt\n",
        "            )\n",
        "            fold_rmse, _, _, _ = eval_regression(\n",
        "                cv_full_df, target_col,\n",
        "                cv_train_end, cv_val_end,\n",
        "                models_cv, scaler_cv, lags, horizon, tt\n",
        "            )\n",
        "            cv_scores[alpha].append(fold_rmse)\n",
        "\n",
        "    mean_scores = {a: np.mean(v) for a, v in cv_scores.items() if v}\n",
        "    best_alpha  = min(mean_scores, key=mean_scores.get)\n",
        "\n",
        "    print(f\"  CV scores by alpha:\")\n",
        "    for a, s in mean_scores.items():\n",
        "        marker = \"  <- best\" if a == best_alpha else \"\"\n",
        "        print(f\"    alpha={a:<12} mean CV RMSE={s:.3f}{marker}\")\n",
        "\n",
        "    return best_alpha, mean_scores"
      ]
    },
