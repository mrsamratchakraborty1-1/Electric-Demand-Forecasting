        "\n",
        "# =============================================================================\n",
        "# MODEL 2: Holt-Winters — S=96 (daily seasonality)\n",
        "# =============================================================================\n",
        "\n",
        "print(\"\\n--- Model 2: Holt-Winters  S=96 (daily) ---\")\n",
        "\n",
        "def fit_hw96(x):\n",
        "    return ExponentialSmoothing(\n",
        "        x,\n",
        "        trend=\"add\",\n",
        "        seasonal=\"add\",\n",
        "        seasonal_periods=96,\n",
        "        initialization_method=\"estimated\",\n",
        "    ).fit(optimized=True)\n",
        "\n",
        "t0 = time.time()\n",
        "val_rmse_hw96, _, val_pred_hw96 = rolling_4step_rmse_demand(\n",
