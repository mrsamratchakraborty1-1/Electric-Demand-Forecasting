      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Threshold : 50,000 MW\n",
            "Outliers found : 1\n",
            "                     TOTALDEMAND    RRP\n",
            "SETTLEMENTDATE                         \n",
            "2026-01-20 09:15:00    635101.58 -14.04\n",
            "\n"
          ]
        }
      ],
      "source": [
        "DEMAND_UPPER_BOUND = 50_000  # MW — well above any plausible NSW peak\n",
        "\n",
        "outlier_mask = df[\"TOTALDEMAND\"] > DEMAND_UPPER_BOUND\n",
        "\n",
        "print(f\"Threshold : {DEMAND_UPPER_BOUND:,} MW\")\n",
        "print(f\"Outliers found : {outlier_mask.sum()}\")\n",
        "if outlier_mask.any():\n",
        "    print(df.loc[outlier_mask, [\"TOTALDEMAND\", \"RRP\"]])\n",
        "\n",
        "# Replace outlier with NaN so it can be interpolated in Step 5\n",
        "df.loc[outlier_mask, \"TOTALDEMAND\"] = np.nan\n",
        "print()"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "S7EpptmRAYvn",
        "outputId": "297e560b-7170-4b0f-c991-d548204b8cae"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Outliers imputed via seasonal naive (lag-24h): 1\n",
            "  Imputed value(s):\n",
            "                     TOTALDEMAND    RRP\n",
            "SETTLEMENTDATE                         \n",
            "2026-01-20 09:15:00      4503.34 -14.04\n",
            "Remaining NaN: TOTALDEMAND=0  RRP=0\n",
            "  Max demand: 11,828 MW\n",
            "  Min demand: 3,267 MW\n",
            "  Final rows: 2687\n"
          ]
        }
      ],
      "source": [
        "# Seasonal naive imputation (lag-96 = 24 h ago)\n",
        "# EDA showed dominant intraday seasonality at period 96. We replace the outlier\n",
        "# with the demand at the same time slot one day earlier - looked up by TIMESTAMP\n",
        "# (robust to the gaps left by removing off-grid rows).\n",
        "SEASONAL_LAG_HOURS = 24\n",
        "outlier_timestamps = df.index[outlier_mask]\n",
        "\n",
        "for ts in outlier_timestamps:\n",
        "    lag_ts = ts - pd.Timedelta(hours=SEASONAL_LAG_HOURS)\n",
        "    if lag_ts in df.index and pd.notna(df.at[lag_ts, \"TOTALDEMAND\"]):\n",
        "        df.at[ts, \"TOTALDEMAND\"] = df.at[lag_ts, \"TOTALDEMAND\"]\n",
        "    else:\n",
        "        # Fallback: look 24 h forward instead (e.g. if outlier is in the first day)\n",
        "        lag_ts = ts + pd.Timedelta(hours=SEASONAL_LAG_HOURS)\n",
        "        if lag_ts in df.index and pd.notna(df.at[lag_ts, \"TOTALDEMAND\"]):\n",
        "            df.at[ts, \"TOTALDEMAND\"] = df.at[lag_ts, \"TOTALDEMAND\"]\n",
        "        else:\n",
        "            raise ValueError(f\"No valid lag-24h value available for outlier at {ts}\")\n",
        "\n",
        "print(f\"Outliers imputed via seasonal naive (lag-{SEASONAL_LAG_HOURS}h): {len(outlier_timestamps)}\")\n",
        "print(f\"  Imputed value(s):\")\n",
        "print(df.loc[outlier_timestamps, [\"TOTALDEMAND\", \"RRP\"]])\n",
        "\n",
        "print(f\"Remaining NaN: TOTALDEMAND={df['TOTALDEMAND'].isnull().sum()}  \"\n",
        "      f\"RRP={df['RRP'].isnull().sum()}\")\n",
        "print(f\"  Max demand: {df['TOTALDEMAND'].max():,.0f} MW\")\n",
        "print(f\"  Min demand: {df['TOTALDEMAND'].min():,.0f} MW\")\n",
        "print(f\"  Final rows: {len(df)}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "DM8DhUj-Jtwm"
      },
      "source": [
        "4. Signed-log transform for RRP"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "7N8zDaaTJtP7"
      },
      "outputs": [],
      "source": [
        "# sign(x)·log(1+|x|) — handles negatives, no data lost, compresses spikes\n",
        "df[\"RRP_signed_log\"] = np.sign(df[\"RRP\"]) * np.log1p(np.abs(df[\"RRP\"]))"
      ]
    },
