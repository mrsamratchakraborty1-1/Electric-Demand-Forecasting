      ],
      "source": [
        "H = 4    # forecast horizon (4 × 15min = 1 h)\n",
        "CAL_COLS = ['sin_pod', 'cos_pod', 'sin_dow', 'cos_dow', 'is_weekend']\n",
        "N_CAL = len(CAL_COLS)\n",
        "\n",
        "def make_sequences(df_in, lookback):\n",
        "    \"\"\"Build sliding-window (X, y) arrays for the MLP.\n",
        "\n",
        "    X[i] = [y_{t-p}, ..., y_{t-1}, calendar features at time t]\n",
        "    y[i] = [y_t, y_{t+1}, y_{t+2}, y_{t+3}]   ← next 4 steps\n",
        "    \"\"\"\n",
        "    y = df_in['TOTALDEMAND'].values.astype(np.float32)\n",
        "    c = df_in[CAL_COLS].values.astype(np.float32)\n",
        "    Xs, ys = [], []\n",
        "    for i in range(lookback, len(y) - H + 1):\n",
        "        Xs.append(np.concatenate([y[i-lookback:i], c[i]]))\n",
        "        ys.append(y[i:i+H])\n",
        "    return np.array(Xs, np.float32), np.array(ys, np.float32)\n",
        "\n",
        "# Sanity check with p = 8\n",
        "X_demo, y_demo = make_sequences(df_tr, lookback=8)\n",
        "print(f'Lookback p=8 → X shape: {X_demo.shape}   y shape: {y_demo.shape}')\n",
        "print(f'Feature dim = p + n_cal = 8 + {N_CAL} = {X_demo.shape[1]}')"
      ]
