      "source": [
        "class DemandMLP(nn.Module):\n",
        "    \"\"\"Multi-layer perceptron for 4-step-ahead demand forecasting.\n",
        "\n",
        "    Architecture:\n",
        "        Input (p + n_cal)  →  Linear → ReLU → Dropout\n",
        "                           →  Linear → ReLU → Dropout\n",
        "                           →  Linear (H outputs)\n",
        "    \"\"\"\n",
        "    def __init__(self, input_dim, hidden_size, dropout):\n",
        "        super().__init__()\n",
        "        self.net = nn.Sequential(\n",
        "            nn.Linear(input_dim,   hidden_size), nn.ReLU(), nn.Dropout(dropout),\n",
        "            nn.Linear(hidden_size, hidden_size), nn.ReLU(), nn.Dropout(dropout),\n",
        "            nn.Linear(hidden_size, H),\n",
        "        )\n",
        "\n",
        "    def forward(self, x):\n",
        "        return self.net(x)\n",
        "\n",
        "# Quick architecture check\n",
        "demo = DemandMLP(input_dim=8 + N_CAL, hidden_size=64, dropout=0.1)\n",
        "n_params = sum(p.numel() for p in demo.parameters())\n",
        "print(demo)\n",
        "print(f'\\nTotal parameters: {n_params:,}')"
      ]
