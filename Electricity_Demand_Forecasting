        "print(f\"Val size      : {len(val_demand)} obs\")\n",
        "print(f\"Test size     : {len(test_demand)} obs\")\n",
        "\n",
        "# =============================================================================\n",
        "# HELPER: Rolling 4-step-ahead RMSE (no transform needed for demand)\n",
        "# =============================================================================\n",
        "\n",
        "def rolling_4step_rmse_demand(train, eval_series, model_fn, horizon=4):\n",
        "    \"\"\"\n",
        "    Non-overlapping rolling origin evaluation.\n",
        "    model_fn(history) → fitted model with .forecast(horizon) method.\n",
        "    \"\"\"\n",
        "    history  = list(train)\n",
        "    actuals, forecasts = [], []\n",
        "    n_windows = len(eval_series) // horizon\n",
        "\n",
        "    for w in range(n_windows):\n",
        "        fit       = model_fn(np.array(history))\n",
        "        pred      = fit.forecast(horizon)\n",
        "        start     = w * horizon\n",
        "        act       = eval_series[start : start + horizon]\n",
        "\n",
        "        actuals.append(act)\n",
        "        forecasts.append(pred)\n",
        "        history.extend(eval_series[start : start + horizon])\n",
        "\n",
        "    actuals   = np.concatenate(actuals)\n",
        "    forecasts = np.concatenate(forecasts)\n",
        "    rmse      = np.sqrt(np.mean((actuals - forecasts) ** 2))\n",
        "    return rmse, actuals, forecasts\n",
        "\n",
        "# =============================================================================\n",
        "# MODEL 1: Simple ETS — baseline (no trend, no seasonality)\n",
        "# =============================================================================\n",
        "\n",
