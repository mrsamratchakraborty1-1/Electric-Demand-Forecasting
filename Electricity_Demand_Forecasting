        "# =============================================================================\n",
        "\n",
        "print(\"\\n--- Model 3: Holt-Winters  S=672 (weekly) ---\")\n",
        "print(\"  Warning: S=672 is computationally intensive, please wait...\")\n",
        "\n",
        "def fit_hw672(x):\n",
        "    return ExponentialSmoothing(\n",
