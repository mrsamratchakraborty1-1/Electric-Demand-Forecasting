      "source": [
        "# =============================================================================\n",
        "# SECTION 1: GRU MODEL DEFINITION\n",
        "# =============================================================================\n",
        "\n",
        "class GRUForecaster(nn.Module):\n",
        "    \"\"\"\n",
        "    Architecture:\n",
        "      Input  : [batch, lookback=96, n_features=7]\n",
        "      GRU    : num_layers stacked, hidden_size units, batch_first=True\n",
        "      Dropout: after last GRU output (regularisation)\n",
        "      FC     : Linear(hidden_size → horizon=4)\n",
        "      Output : [batch, 4]  — direct multi-step, all 4 steps simultaneously\n",
        "    \"\"\"\n",
        "    def __init__(self, n_features, hidden_size, num_layers, dropout, horizon):\n",
        "        super().__init__()\n",
        "        self.gru = nn.GRU(\n",
        "            input_size  = n_features,\n",
        "            hidden_size = hidden_size,\n",
        "            num_layers  = num_layers,\n",
        "            batch_first = True,\n",
        "            dropout     = dropout if num_layers > 1 else 0.0,\n",
        "        )\n",
        "        self.dropout = nn.Dropout(dropout)\n",
        "        self.fc      = nn.Linear(hidden_size, horizon)\n",
        "\n",
        "    def forward(self, x):\n",
        "        out, _ = self.gru(x)       # [batch, lookback, hidden_size]\n",
        "        out    = out[:, -1, :]     # last time step: [batch, hidden_size]\n",
        "        return self.fc(self.dropout(out))   # [batch, horizon]"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "2vhAQ3jrZWcY"
      },
      "outputs": [],
      "source": [
        "# =============================================================================\n",
        "# SECTION 2: TRAINING FUNCTION\n",
        "# LeCun Efficient BackProp recommendations applied:\n",
        "#   - Inputs normalised via StandardScaler (done in Section 1)\n",
        "#   - Adam optimiser (adaptive learning rate)\n",
        "#   - Gradient clipping (prevents exploding gradients with RRP spikes)\n",
        "#   - Early stopping (prevents overfitting on small dataset)\n",
        "#   - ReduceLROnPlateau scheduler (reduces lr when val loss plateaus)\n",
        "# =============================================================================\n",
        "\n",
        "def train_gru(X_tr, Y_tr, X_vl, Y_vl,\n",
        "              hidden_size, num_layers, lr,\n",
        "              dropout=0.2, batch_size=64,\n",
        "              max_epochs=100, patience=10, verbose=False):\n",
        "\n",
        "    n_features = X_tr.shape[2]\n",
        "    model      = GRUForecaster(n_features, hidden_size, num_layers, dropout, HORIZON).to(DEVICE)\n",
        "    optimiser  = torch.optim.Adam(model.parameters(), lr=lr)\n",
        "    criterion  = nn.MSELoss()\n",
        "    scheduler  = torch.optim.lr_scheduler.ReduceLROnPlateau(\n",
        "                optimiser, patience=5, factor=0.5)\n",
        "    loader     = DataLoader(\n",
        "                    TensorDataset(X_tr.to(DEVICE), Y_tr.to(DEVICE)),\n",
        "                    batch_size=batch_size, shuffle=True)\n",
        "\n",
        "    X_vl_d, Y_vl_d = X_vl.to(DEVICE), Y_vl.to(DEVICE)\n",
        "    best_val_loss = float(\"inf\")\n",
        "    best_weights  = {k: v.cpu().clone() for k, v in model.state_dict().items()}\n",
        "    best_epoch    = 0\n",
        "    no_improve    = 0\n",
        "    train_losses, val_losses = [], []\n",
        "\n",
        "    for epoch in range(max_epochs):\n",
        "        model.train()\n",
        "        batch_losses = []\n",
        "        for xb, yb in loader:\n",
        "            optimiser.zero_grad()\n",
        "            loss = criterion(model(xb), yb)\n",
        "            loss.backward()\n",
        "            nn.utils.clip_grad_norm_(model.parameters(), max_norm=1.0)\n",
        "            optimiser.step()\n",
        "            batch_losses.append(loss.item())\n",
        "        train_loss = np.mean(batch_losses)\n",
        "\n",
        "        model.eval()\n",
        "        with torch.no_grad():\n",
        "            val_loss = criterion(model(X_vl_d), Y_vl_d).item()\n",
        "\n",
        "        scheduler.step(val_loss)\n",
        "        train_losses.append(train_loss)\n",
        "        val_losses.append(val_loss)\n",
        "\n",
        "        if val_loss < best_val_loss:\n",
        "            best_val_loss = val_loss\n",
        "            best_weights  = {k: v.cpu().clone() for k, v in model.state_dict().items()}\n",
        "            best_epoch    = epoch + 1\n",
        "            no_improve    = 0\n",
        "        else:\n",
        "            no_improve += 1\n",
        "            if no_improve >= patience:\n",
        "                if verbose:\n",
        "                    print(f\"    Early stop at epoch {epoch+1} (best: {best_epoch})\")\n",
        "                break\n",
        "\n",
        "        if verbose and (epoch + 1) % 20 == 0:\n",
        "            print(f\"    Epoch {epoch+1:3d} | train={train_loss:.4f} | val={val_loss:.4f}\")\n",
        "\n",
        "    model.load_state_dict(best_weights)\n",
        "    return model, train_losses, val_losses, best_epoch"
      ]
    },
