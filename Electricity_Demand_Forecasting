      "metadata": {
        "id": "TipEATKZEdqC"
      },
      "source": [
        "6. establish timestamp feature engineering"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "FrxZB0XAD2Ln"
      },
      "outputs": [],
      "source": [
        "# Timestamp-based feature engineering\n",
        "# These columns support calendar-feature regression and seasonal naive models.\n",
        "df = df.reset_index()\n",
        "\n",
        "df[\"hour\"]= df[\"SETTLEMENTDATE\"].dt.hour\n",
        "df[\"minute\"]= df[\"SETTLEMENTDATE\"].dt.minute\n",
        "df[\"dayofweek\"]= df[\"SETTLEMENTDATE\"].dt.dayofweek   # 0 = Mon … 6 = Sun\n",
        "df[\"is_weekend\"]= df[\"dayofweek\"].isin([5, 6]).astype(int)\n",
        "df[\"period_of_day\"]= df[\"hour\"] * 4 + df[\"minute\"] // 15  # 0–95 (96 per day)"
      ]
    },
