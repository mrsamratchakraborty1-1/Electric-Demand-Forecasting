        "# =============================================================================\n",
        "# NAIVE BASELINES (4-step-ahead RMSE, non-overlapping windows)\n",
        "# =============================================================================\n",
        "\n",
        "def seasonal_naive_forecast(series_values, horizon=4, period=96):\n",
        "    \"\"\"\n",
        "    Seasonal Naive: predict T+h using the value from S steps before T+h.\n",
        "    For S=96 (daily): same time slot 24 hours ago.\n",
        "    \"\"\"\n",
        "    n = len(series_values)\n",
        "    return [series_values[n - period + h - 1] for h in range(1, horizon + 1)]\n",
        "\n",
        "\n",
        "def rolling_eval_naive(full_series, train_end_idx, kind=\"seasonal\",\n",
        "                        period=96, horizon=4):\n",
        "    \"\"\"\n",
        "    Non-overlapping rolling 4-step-ahead evaluation.\n",
        "    Evaluates from train_end_idx to end of series in steps of horizon.\n",
        "    \"\"\"\n",
        "    actuals, preds = [], []\n",
        "    for t in range(train_end_idx, len(full_series) - horizon + 1, horizon):\n",
        "        hist = full_series[:t]\n",
        "        if kind == \"naive\":\n",
        "            fc = [float(hist[-1])] * horizon\n",
        "        else:\n",
        "            fc = seasonal_naive_forecast(hist, horizon=horizon, period=period)\n",
        "        actuals.extend(full_series[t : t + horizon].tolist())\n",
        "        preds.extend(fc)\n",
        "    return rmse(actuals, preds)\n",
        "\n",
        "\n",
        "# Use cleaned full data (anomaly imputed, off-grid rows removed)\n",
        "TRAIN_N_NAIVE = len(df)                  # cleaned training set length\n",
        "VAL_N_NAIVE   = len(df_val_raw)          # val set length\n",
        "\n",
        "full_demand = df_full_reg[\"TOTALDEMAND\"].values\n",
        "full_price  = df_full_reg[\"RRP\"].values\n",
        "\n",
        "naive_rmse_store = {}\n",
        "\n",
        "print(\"=\" * 55)\n",
        "print(\"NAIVE BASELINES  (4-step-ahead RMSE, non-overlapping windows)\")\n",
        "print(\"=\" * 55)\n",
        "\n",
        "for name, series, label in [\n",
        "    (\"TOTALDEMAND\", full_demand, \"MW\"),\n",
        "    (\"RRP\",         full_price,  \"$/MWh\"),\n",
        "]:\n",
        "    store = {}\n",
        "    print(f\"\\n{name} ({label})\")\n",
        "    print(f\"  {'Model':<20} {'Val RMSE':>12} {'Test RMSE':>12}\")\n",
        "    print(f\"  {'-' * 44}\")\n",
        "\n",
        "    for kind, label_k, key in [\n",
        "        (\"naive\",    \"Naive\",          \"naive\"),\n",
        "        (\"seasonal\", \"Seasonal Naive\", \"snaive\"),\n",
        "    ]:\n",
        "        rv = rolling_eval_naive(series, TRAIN_N_NAIVE,\n",
        "                                kind=kind, period=96, horizon=4)\n",
        "        rt = rolling_eval_naive(series, TRAIN_N_NAIVE + VAL_N_NAIVE,\n",
        "                                kind=kind, period=96, horizon=4)\n",
        "        store[f\"{key}_val\"]  = rv\n",
        "        store[f\"{key}_test\"] = rt\n",
        "        print(f\"  {label_k:<20} {rv:>12.3f} {rt:>12.3f}\")\n",
        "\n",
        "    naive_rmse_store[name] = store\n"
      ]
