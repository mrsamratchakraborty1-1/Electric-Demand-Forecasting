        "import torch\n",
        "import torch.nn as nn\n",
        "from torch.utils.data import DataLoader, TensorDataset\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from itertools import product\n",
        "\n",
        "# ── Reproducibility ───────────────────────────────────────────────────────────\n",
        "SEED = 42\n",
        "torch.manual_seed(SEED)\n",
        "np.random.seed(SEED)\n",
        "\n",
        "DEVICE = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
        "print(f\"\\nDevice: {DEVICE}\")\n",
        "\n",
        "# =============================================================================\n",
        "# SECTION 1: FEATURE ENGINEERING FOR VAL / TEST\n",
        "# Category A only (no leakage) — same deterministic rules as training\n",
        "# df already has RRP_signed_log, period_of_day, dayofweek, is_weekend\n",
        "# =============================================================================\n",
        "\n",
        "def add_gru_features(df_in):\n",
        "    \"\"\"Add signed-log RRP + cyclical calendar features. Category A — safe on val/test.\"\"\"\n",
        "    out = df_in.copy()\n",
        "    out[\"rrp_slog\"]   = np.sign(out[\"RRP\"].values) * np.log1p(np.abs(out[\"RRP\"].values))\n",
        "    slot              = out[\"SETTLEMENTDATE\"].dt.hour * 4 + out[\"SETTLEMENTDATE\"].dt.minute // 15\n",
        "    dow               = out[\"SETTLEMENTDATE\"].dt.dayofweek\n",
        "    out[\"hour_sin\"]   = np.sin(2 * np.pi * slot / 96)\n",
        "    out[\"hour_cos\"]   = np.cos(2 * np.pi * slot / 96)\n",
        "    out[\"dow_sin\"]    = np.sin(2 * np.pi * dow  /  7)\n",
        "    out[\"dow_cos\"]    = np.cos(2 * np.pi * dow  /  7)\n",
        "    out[\"is_weekend\"] = (dow >= 5).astype(float)\n",
        "    return out\n",
        "\n",
        "# Apply to val and test (raw → featured)\n",
        "df_val_feat  = add_gru_features(df_val_raw)\n",
        "df_test_feat = add_gru_features(df_test_raw)\n",
        "\n",
        "# Training: reuse df (already cleaned), compute same features from existing cols\n",
        "df_train_feat = df.copy()\n",
        "df_train_feat[\"rrp_slog\"] = df_train_feat[\"RRP_signed_log\"]   # already computed\n",
        "slot_tr = df_train_feat[\"period_of_day\"]   # 0–95\n",
        "dow_tr  = df_train_feat[\"dayofweek\"]\n",
        "df_train_feat[\"hour_sin\"]  = np.sin(2 * np.pi * slot_tr / 96)\n",
        "df_train_feat[\"hour_cos\"]  = np.cos(2 * np.pi * slot_tr / 96)\n",
        "df_train_feat[\"dow_sin\"]   = np.sin(2 * np.pi * dow_tr  /  7)\n",
        "df_train_feat[\"dow_cos\"]   = np.cos(2 * np.pi * dow_tr  /  7)\n",
        "\n",
        "FEATURE_COLS = [\n",
        "    \"rrp_slog\", \"TOTALDEMAND\",\n",
        "    \"hour_sin\", \"hour_cos\", \"dow_sin\", \"dow_cos\", \"is_weekend\"\n",
        "]\n",
        "TARGET_COL = \"rrp_slog\"\n",
        "\n",
        "# ── Category B: StandardScaler fit on train ONLY ─────────────────────────────\n",
        "scaler_X = StandardScaler()\n",
        "scaler_X.fit(df_train_feat[FEATURE_COLS].values)"
