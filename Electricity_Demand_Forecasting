        "configs = list(itertools.product(LOOKBACKS, HIDDENS, DROPOUTS))\n",
        "print(f'Total configurations: {len(configs)}\\n')\n",
        "\n",
        "for run_id, (lb, h, dr) in enumerate(configs, 1):\n",
        "    t0 = time.time()\n",
        "\n",
        "    X_tr, y_tr = make_sequences(df_tr, lookback=lb)\n",
        "    X_va, y_va = make_sequences(\n",
        "        pd.concat([df_tr.iloc[-lb:], df_va], ignore_index=True), lookback=lb)\n",
        "\n",
        "    scaler_X = StandardScaler().fit(X_tr)\n",
        "    scaler_y = StandardScaler().fit(y_tr.reshape(-1, 1))\n",
        "    X_tr_s   = scaler_X.transform(X_tr).astype(np.float32)\n",
        "    X_va_s   = scaler_X.transform(X_va).astype(np.float32)\n",
        "    y_tr_s   = scaler_y.transform(y_tr.reshape(-1, 1)).reshape(y_tr.shape).astype(np.float32)\n",
        "    y_va_s   = scaler_y.transform(y_va.reshape(-1, 1)).reshape(y_va.shape).astype(np.float32)\n",
        "\n",
        "    model = DemandMLP(input_dim=lb + N_CAL, hidden_size=h, dropout=dr)\n",
        "    model, tr_h, va_h, _ = train_mlp(\n",
        "        model, X_tr_s, y_tr_s, X_va_s, y_va_s,\n",
        "        lr=1e-3, epochs=80, batch_size=128, patience=10)\n",
        "\n",
        "    act_va, pred_va = walk_forward_predict(\n",
        "        model, scaler_X, scaler_y, df_tr, df_va, lookback=lb, step=4)\n",
        "    val_rmse = rmse(act_va, pred_va)\n",
        "\n",
        "    elapsed = time.time() - t0\n",
        "    print(f'[{run_id:>2}/{len(configs)}] p={lb:>3}  k={h:>3}  dr={dr:.1f}  '\n",
        "          f'→ Val RMSE = {val_rmse:>7.2f} MW ({elapsed:.0f}s)')\n",
        "\n",
        "    results.append(dict(\n",
        "        lookback=lb, hidden=h, dropout=dr,\n",
