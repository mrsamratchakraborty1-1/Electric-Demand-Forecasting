          "output_type": "stream",
          "name": "stdout",
          "text": [
            "DemandMLP(\n",
            "  (net): Sequential(\n",
            "    (0): Linear(in_features=13, out_features=64, bias=True)\n",
            "    (1): ReLU()\n",
            "    (2): Dropout(p=0.1, inplace=False)\n",
            "    (3): Linear(in_features=64, out_features=64, bias=True)\n",
            "    (4): ReLU()\n",
            "    (5): Dropout(p=0.1, inplace=False)\n",
