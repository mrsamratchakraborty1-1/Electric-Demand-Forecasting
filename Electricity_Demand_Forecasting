        "# =============================================================================\n",
        "# SECTION 3: MLP MODEL DEFINITION\n",
        "# =============================================================================\n",
        "\n",
        "class MLPForecaster(nn.Module):\n",
        "    \"\"\"\n",
        "    Architecture:\n",
        "      Input  : [batch, n_features]  (flat lag + calendar features)\n",
        "      Hidden : num_layers × hidden_size with ReLU activation\n",
        "      Dropout: after each hidden layer (regularisation)\n",
        "      Output : [batch, horizon=4]   (direct multi-step)\n",
        "    LeCun recommendations applied:\n",
        "      - Inputs normalised via StandardScaler\n",
        "      - ReLU activations (efficient gradient flow)\n",
        "      - Dropout for regularisation on small dataset\n",
        "    \"\"\"\n",
        "    def __init__(self, n_features, hidden_size, num_layers, dropout, horizon):\n",
        "        super().__init__()\n",
        "        layers = []\n",
        "        in_size = n_features\n",
        "        for _ in range(num_layers):\n",
        "            layers += [\n",
        "                nn.Linear(in_size, hidden_size),\n",
        "                nn.ReLU(),\n",
        "                nn.Dropout(dropout),\n",
        "            ]\n",
        "            in_size = hidden_size\n",
        "        layers.append(nn.Linear(hidden_size, horizon))\n",
        "        self.net = nn.Sequential(*layers)\n",
        "\n",
        "    def forward(self, x):\n",
        "        return self.net(x)"
      ]
