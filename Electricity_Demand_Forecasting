        "def prepare(df_in):\n",
        "    \"\"\"Reproduce Section 1 cleaning: grid alignment, outlier fix, interpolation,\n",
        "    signed-log RRP, and calendar features.\"\"\"\n",
        "    d = df_in.copy()\n",
        "    d['SETTLEMENTDATE'] = pd.to_datetime(d['SETTLEMENTDATE'])\n",
        "    d = d.sort_values('SETTLEMENTDATE').reset_index(drop=True)\n",
        "    grid = pd.date_range(d['SETTLEMENTDATE'].min(), d['SETTLEMENTDATE'].max(), freq='15min')\n",
        "    d = d[d['SETTLEMENTDATE'].isin(grid)].set_index('SETTLEMENTDATE').reindex(grid)\n",
        "    d.index.name = 'SETTLEMENTDATE'\n",
        "    d.loc[d['TOTALDEMAND'] > 50_000, 'TOTALDEMAND'] = np.nan\n",
        "    d['TOTALDEMAND'] = d['TOTALDEMAND'].interpolate(method='time')\n",
        "    d['RRP']         = d['RRP'].interpolate(method='time')\n",
        "    d['RRP_signed_log'] = np.sign(d['RRP']) * np.log1p(np.abs(d['RRP']))\n",
        "    d = d.reset_index()\n",
        "    d['hour']          = d['SETTLEMENTDATE'].dt.hour\n",
        "    d['minute']        = d['SETTLEMENTDATE'].dt.minute\n",
        "    d['dayofweek']     = d['SETTLEMENTDATE'].dt.dayofweek\n",
        "    d['is_weekend']    = d['dayofweek'].isin([5, 6]).astype(float)\n",
        "    d['period_of_day'] = d['hour'] * 4 + d['minute'] // 15\n",
        "    d['sin_pod']       = np.sin(2 * np.pi * d['period_of_day'] / 96) # Hour-of-day and day-of-week are circular - hour 23 is adjacent to hour 0. Encoding with sin/cos lets the network learn that 23:45 and 00:15 are close\n",
        "    d['cos_pod']       = np.cos(2 * np.pi * d['period_of_day'] / 96)\n",
        "    d['sin_dow']       = np.sin(2 * np.pi * d['dayofweek'] / 7)\n",
        "    d['cos_dow']       = np.cos(2 * np.pi * d['dayofweek'] / 7)\n",
        "    return d\n",
        "\n",
        "# `df` is the cleaned training set, but does not have sin/cos features yet.\n",
        "# Apply the prepare function to df_train_raw to get all features.\n",
        "df_tr  = prepare(df_train_raw)\n",
