      },
      "source": [
        "2. Build 15-minute grid"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "I47JYF9bBe-S",
        "outputId": "c3f05c84-914b-46d5-8fa6-a2d79734b6dd"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Expected timestamps: 2687\n",
            "Actual rows: 2689\n",
            "Difference: 2\n"
          ]
        }
      ],
      "source": [
        "start_time = df['SETTLEMENTDATE'].min()\n",
        "end_time   = df['SETTLEMENTDATE'].max()\n",
        "full_grid  = pd.date_range(start=start_time, end=end_time, freq=\"15min\")\n",
        "\n",
        "print(f\"Expected timestamps: {len(full_grid)}\")\n",
        "print(f\"Actual rows: {len(df)}\")\n",
        "print(f\"Difference: {len(df) - len(full_grid)}\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "F05-EH8xCPn9",
        "outputId": "77818edd-04f4-40ca-bc12-ea3959a936bf"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Found 2 off-grid row(s):\n",
            "     SETTLEMENTDATE  TOTALDEMAND   RRP\n",
            "2026-01-02 02:20:00      6377.32 80.01\n",
            "2026-01-19 06:50:00          NaN -5.20\n",
            "Rows after removing off-grid timestamps : 2687\n"
          ]
        }
      ],
      "source": [
        "# remove off-grid timestamps\n",
        "# Any timestamp that does not fall on the 15-minute grid is invalid\n",
        "off_grid_mask = ~df[\"SETTLEMENTDATE\"].isin(full_grid)\n",
        "off_grid_rows = df[off_grid_mask].copy()\n",
        "\n",
        "if off_grid_rows.empty:\n",
        "    print(\"No off-grid timestamps found.\")\n",
        "else:\n",
        "    print(f\"Found {len(off_grid_rows)} off-grid row(s):\")\n",
        "    print(off_grid_rows.to_string(index=False))\n",
        "\n",
        "df = df[~off_grid_mask].copy()\n",
        "df = df.set_index(\"SETTLEMENTDATE\").sort_index()\n",
        "df.index.name = \"SETTLEMENTDATE\"\n",
        "print(f\"Rows after removing off-grid timestamps : {len(df)}\")"
      ]
    },
