      "source": [
        "print(\"=\" * 60)\n",
        "print(\"TASK B: SIMPLE ETS — RRP (Signed-Log Scale)\")\n",
        "print(\"=\" * 60)\n",
        "\n",
        "# =============================================================================\n",
        "# STEP 1: FIT SIMPLE ETS ON TRAINING SET\n",
        "# smoothing_level=None → statsmodels optimises α automatically\n",
        "# =============================================================================\n",
        "\n",
        "ets_rrp = SimpleExpSmoothing(train_rrp_slog, initialization_method=\"estimated\")\n",
        "ets_rrp_fit = ets_rrp.fit(optimized=True)\n",
        "\n",
        "alpha_opt = ets_rrp_fit.params[\"smoothing_level\"]\n",
        "print(f\"\\nOptimised α (smoothing level) : {alpha_opt:.3f}\")\n",
        "print(f\"  → Small α means slow adaptation (more weight on history)\")\n",
        "print(f\"  → Large α means fast adaptation (more weight on recent obs)\")\n",
        "\n",
        "# =============================================================================\n",
        "# STEP 2: ROLLING 4-STEP-AHEAD EVALUATION ON VALIDATION SET\n",
        "# Non-overlapping windows: forecast 4 steps, advance 4 steps, repeat\n",
        "# =============================================================================\n",
        "\n",
        "def rolling_4step_rmse(train_slog, eval_slog, eval_raw, alpha, horizon=4):\n",
        "    \"\"\"\n",
        "    Rolling origin evaluation with non-overlapping 4-step windows.\n",
        "    At each origin, refit ETS on all data up to that point, forecast 4 steps.\n",
        "    Inverse-transforms predictions before computing RMSE in original space.\n",
        "    \"\"\"\n",
        "    history = list(train_slog)\n",
        "    actuals, forecasts = [], []\n",
        "    n_windows = len(eval_slog) // horizon\n",
        "\n",
        "    for w in range(n_windows):\n",
        "        # Fit on all history up to current origin\n",
        "        model = SimpleExpSmoothing(history, initialization_method=\"estimated\")\n",
        "        fit   = model.fit(smoothing_level=alpha, optimized=False)\n",
        "\n",
        "        # Forecast next 4 steps in signed-log space\n",
        "        pred_slog = fit.forecast(horizon)\n",
        "\n",
        "        # Inverse transform → original $/MWh\n",
        "        pred_raw  = inverse_signed_log(pred_slog)\n",
        "\n",
        "        # Actual values for this window (original space)\n",
        "        start = w * horizon\n",
        "        act_raw = eval_raw[start : start + horizon]\n",
        "\n",
        "        actuals.append(act_raw)\n",
        "        forecasts.append(pred_raw)\n",
        "\n",
        "        # Advance history by 4 steps using actual values\n",
        "        history.extend(eval_slog[start : start + horizon])\n",
        "\n",
        "    actuals   = np.concatenate(actuals)\n",
        "    forecasts = np.concatenate(forecasts)\n",
        "    rmse = np.sqrt(np.mean((actuals - forecasts) ** 2))\n",
        "    return rmse, actuals, forecasts\n",
        "\n",
        "val_rmse, val_act, val_pred = rolling_4step_rmse(\n",
        "    train_rrp_slog, val_rrp_slog, val_rrp_raw, alpha_opt\n",
        ")\n",
        "print(f\"\\nValidation RMSE (original $/MWh) : {val_rmse:.3f}\")\n",
        "\n",
        "# =============================================================================\n",
        "# STEP 3: FINAL EVALUATION ON TEST SET\n",
        "# (parameters fixed from training — no further tuning)\n",
        "# =============================================================================\n",
        "\n",
        "test_rmse, test_act, test_pred = rolling_4step_rmse(\n",
        "    np.concatenate([train_rrp_slog, val_rrp_slog]),   # expand history to include val\n",
        "    test_rrp_slog, test_rrp_raw, alpha_opt\n",
        ")\n",
        "print(f\"Test RMSE     (original $/MWh) : {test_rmse:.3f}\")\n",
        "\n",
        "# =============================================================================\n",
        "# STEP 4: FORECAST — last 4 steps (T+1 to T+4)\n",
        "# Fit on all available data (train + val + test), forecast next 4 steps\n",
        "# =============================================================================\n",
