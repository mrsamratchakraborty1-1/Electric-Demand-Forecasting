      "source": [
        "# FEATURE ENGINEERING\n",
        "LAGS    = [1, 2, 3, 4, 96, 192, 96 * 7]\n",
        "HORIZON = 4\n",
        "ALPHAS  = [0.001, 0.01, 0.1, 1.0, 10.0, 100.0, 1_000.0, 10_000.0, 100_000.0, 1_000_000.0]\n",
        "\n",
        "\n",
        "def build_features(df_in, target_col, lags, horizon=4):\n",
        "    data = df_in.copy()\n",
        "    ts   = data[\"SETTLEMENTDATE\"]\n",
        "\n",
        "    for lag in lags:\n",
        "        data[f\"lag_{lag}\"] = data[target_col].shift(lag)\n",
        "\n",
        "    data[\"dow\"]       = ts.dt.dayofweek\n",
        "    data[\"is_weekend\"]= (data[\"dow\"] >= 5).astype(int)\n",
        "    data[\"slot\"]      = ts.dt.hour * 4 + ts.dt.minute // 15\n",
        "\n",
        "    data[\"hour_sin\"] = np.sin(2 * np.pi * data[\"slot\"] / 96)\n",
        "    data[\"hour_cos\"] = np.cos(2 * np.pi * data[\"slot\"] / 96)\n",
        "    data[\"dow_sin\"]  = np.sin(2 * np.pi * data[\"dow\"]  /  7)\n",
        "    data[\"dow_cos\"]  = np.cos(2 * np.pi * data[\"dow\"]  /  7)\n",
        "\n",
        "    feature_cols = (\n",
        "        [f\"lag_{l}\" for l in lags]\n",
        "        + [\"hour_sin\", \"hour_cos\", \"dow_sin\", \"dow_cos\", \"is_weekend\"]\n",
        "    )\n",
        "    targets = {}\n",
        "    for h in range(1, horizon + 1):\n",
        "        data[f\"y_h{h}\"] = data[target_col].shift(-h)\n",
        "        targets[h] = f\"y_h{h}\"\n",
        "\n",
        "    data = data.dropna(subset=feature_cols + list(targets.values()))\n",
        "    X = data[feature_cols].values\n",
        "    Y = {h: data[targets[h]].values for h in range(1, horizon + 1)}\n",
        "    return X, Y, feature_cols, data.index\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "Ws-3jfxZh_Wc"
      },
      "outputs": [],
      "source": [
        "# REGRESSION MODEL  (Direct Multi-Step)\n",
        "\n",
        "def train_direct_regression(train_df, target_col, lags=LAGS, horizon=HORIZON,\n",
        "                             alpha=1.0, target_transform=None):\n",
        "    X, Y, feat_cols, _ = build_features(train_df, target_col, lags, horizon)\n",
        "    scaler   = StandardScaler()\n",
        "    X_scaled = scaler.fit_transform(X)\n",
        "    models   = {}\n",
        "    for h in range(1, horizon + 1):\n",
        "        y_h = Y[h].reshape(-1, 1)\n",
        "        if target_transform is not None:\n",
        "            y_h = target_transform.transform(y_h).ravel()\n",
        "        else:\n",
        "            y_h = y_h.ravel()\n",
        "        model = Ridge(alpha=alpha)\n",
        "        model.fit(X_scaled, y_h)\n",
        "        models[h] = model\n",
        "    return models, scaler, feat_cols\n",
        "\n",
        "\n",
        "def eval_regression(df_full, target_col, train_end, eval_end,\n",
        "                    models, scaler, lags=LAGS, horizon=HORIZON,\n",
        "                    target_transform=None):\n",
        "    \"\"\"Returns (rmse, actuals, preds, timestamps).\"\"\"\n",
        "    actuals_all, preds_all, ts_all = [], [], []\n",
        "    series = df_full[target_col].values\n",
        "    ts_arr = df_full[\"SETTLEMENTDATE\"].values\n",
        "\n",
        "    for t in range(train_end, eval_end - horizon + 1, horizon):\n",
        "        row = {f\"lag_{lag}\": series[t - lag] for lag in lags}\n",
        "        dt   = pd.Timestamp(ts_arr[t])\n",
        "        slot = dt.hour * 4 + dt.minute // 15\n",
        "        dow  = dt.dayofweek\n",
        "        row.update({\n",
        "            \"hour_sin\":   np.sin(2 * np.pi * slot / 96),\n",
        "            \"hour_cos\":   np.cos(2 * np.pi * slot / 96),\n",
        "            \"dow_sin\":    np.sin(2 * np.pi * dow  /  7),\n",
        "            \"dow_cos\":    np.cos(2 * np.pi * dow  /  7),\n",
        "            \"is_weekend\": int(dow >= 5),\n",
        "        })\n",
        "        feat_order = (\n",
        "            [f\"lag_{l}\" for l in lags]\n",
        "            + [\"hour_sin\", \"hour_cos\", \"dow_sin\", \"dow_cos\", \"is_weekend\"]\n",
        "        )\n",
        "        x_row    = np.array([row[f] for f in feat_order]).reshape(1, -1)\n",
        "        x_scaled = scaler.transform(x_row)\n",
        "        fc       = [models[h].predict(x_scaled)[0] for h in range(1, horizon + 1)]\n",
        "\n",
        "        if target_transform is not None:\n",
        "            fc = target_transform.inverse_transform(\n",
        "                np.array(fc).reshape(-1, 1)\n",
        "            ).ravel().tolist()\n",
        "\n",
        "        preds_all.extend(fc)\n",
        "        actuals_all.extend(series[t: t + horizon])\n",
        "        ts_all.extend(ts_arr[t: t + horizon])   # timestamps for plotting\n",
        "\n",
        "    return rmse(actuals_all, preds_all), np.array(actuals_all), np.array(preds_all), ts_all"
      ]
    },
    {
      "cell_type": "code",
