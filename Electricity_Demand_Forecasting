        "6. Walk-Forward Evaluation\n",
        "\n",
        "(slide the\n",
        "forecast origin through the test set, produce a fresh 4-step forecast every step periods)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "mTdT_N6JR0AF"
      },
      "outputs": [],
      "source": [
        "def walk_forward_predict(model, scaler_X, scaler_y, df_fit, df_eval, lookback, step=4):\n",
        "    \"\"\"Roll through df_eval producing H-step forecasts every `step` periods.\"\"\"\n",
        "    full = pd.concat([df_fit, df_eval], ignore_index=True)\n",
        "    nf   = len(df_fit)\n",
        "    y_all = full['TOTALDEMAND'].values.astype(np.float32)\n",
        "    c_all = full[CAL_COLS].values.astype(np.float32)\n",
        "\n",
        "    acts, preds = [], []\n",
        "    model.eval()\n",
        "    for s in range(0, len(df_eval) - H + 1, step):\n",
        "        i = nf + s\n",
        "        if i < lookback:\n",
        "            continue\n",
        "        x = np.concatenate([y_all[i-lookback:i], c_all[i]])[None]\n",
        "        x_s = scaler_X.transform(x).astype(np.float32)\n",
        "        with torch.no_grad():\n",
        "            yhat_s = model(torch.tensor(x_s).to(DEVICE)).cpu().numpy()[0]\n",
        "        yhat = scaler_y.inverse_transform(yhat_s.reshape(-1, 1)).flatten()\n",
        "        acts.append(df_eval['TOTALDEMAND'].values[s:s+H])\n",
        "        preds.append(yhat)\n",
        "    return np.concatenate(acts), np.concatenate(preds)\n",
        "\n",
        "def rmse(a, b):\n",
        "    return float(np.sqrt(mean_squared_error(a, b)))"
      ]
    },
